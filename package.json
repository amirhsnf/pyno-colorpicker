{
  "name": "pyno-colorpicker",
  "version": "1.0.1",
  "description": "A lightweight, standalone, zero-dependency color picker for Angular. Supports Hex, RGB and HSL in any valid CSS format, alpha, eyedropper, popup or inline mode, and full theming via CSS variables.",
  "keywords": [
    "angular",
    "colorpicker",
    "color-picker",
    "color",
    "picker",
    "hex",
    "rgb",
    "hsl",
    "hsv",
    "alpha",
    "eyedropper",
    "standalone",
    "pyno"
  ],
  "author": "Amir Navidfar <amirhsnf@gmail.com> (https://github.com/amirhsnf)",
  "license": "MIT",
  "homepage": "https://github.com/amirhsnf/pyno-colorpicker",
  "repository": {
    "type": "git",
    "url": "https://github.com/amirhsnf/pyno-colorpicker"
  },
  "bugs": {
    "url": "https://github.com/amirhsnf/pyno-colorpicker/issues"
  },
  "peerDependencies": {
    "@angular/common": "^22.1.0",
    "@angular/core": "^22.1.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "module": "fesm2022/pyno-colorpicker.mjs",
  "typings": "types/pyno-colorpicker.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./types/pyno-colorpicker.d.ts",
      "default": "./fesm2022/pyno-colorpicker.mjs"
    }
  }
}
